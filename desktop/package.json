{
  "name": "sudo-chan-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A quiet, friendly desktop AI companion. Early prototype.",
  "author": {
    "name": "Sid",
    "email": "noreply@sudo-chan.vercel.app"
  },
  "type": "module",
  "main": "dist/main/bootstrap.js",
  "desktopName": "sudo-chan.desktop",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "electron .",
    "package": "npm run build && electron-builder --dir",
    "package:linux": "npm run build && electron-builder --linux AppImage deb",
    "package:win": "npm run build && electron-builder --win nsis",
    "package:mac": "npm run build && electron-builder --mac dmg",
    "test": "node --test tests/*.check.mjs",
    "postinstall": "install-electron",
    "verify": "node scripts/verify-integrated.mjs",
    "dist": "npm run build && electron-builder --publish never"
  },
  "build": {
    "appId": "app.sudochan.desktop",
    "productName": "Sudo-chan",
    "copyright": "Copyright (c) Sid",
    "artifactName": "Sudo-chan-${version}-${os}-${arch}.${ext}",
    "publish": null,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "assets/icon.png",
      "!**/*.map",
      "!**/*.test.*",
      "!**/*.check.mjs",
      "!**/.env*",
      "!**/config.json"
    ],
    "asar": true,
    "electronLanguages": [
      "en-US"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/linux-icons",
      "executableName": "sudo-chan",
      "maintainer": "Sid <noreply@sudo-chan.vercel.app>",
      "synopsis": "Desktop AI companion",
      "desktop": {
        "entry": {
          "Name": "Sudo-chan",
          "Comment": "A quiet, friendly desktop AI companion",
          "StartupWMClass": "sudo-chan"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "electron-store": "12.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "homepage": "https://sudo-chan.vercel.app",
  "license": "UNLICENSED"
}
